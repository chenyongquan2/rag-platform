# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Model gateway (OpenAI-compatible).
LLM_BASE_URL=
LLM_API_KEY=
EMBED_BASE_URL=
EMBED_API_KEY=

# Optional overrides (defaults in src/rag/config/settings.py).
# ES_URL=http://127.0.0.1:29200
# REDIS_URL=redis://127.0.0.1:26379/0
# DOCSTORE_URL=file://data/docstore
# CHECKPOINT_URL=sqlite://data/checkpoints/langgraph.db
# LOCK_URL=file://data/locks
# OTLP_ENDPOINT=http://127.0.0.1:24317
# HF_ENDPOINT=https://hf-mirror.com
# HF_DATA_DIR=data/raw/hf
# HF_TIMEOUT_S=60

# Embeddings (spec P0-05). EMBED_BACKEND=fake switches ingest and query to FakeEmbedding.
# EMBED_BACKEND=gateway
# EMBED_BATCH_SIZE=10                 # the gateway accepts at most 10 inputs per request
# EMBED_TEXT_PREFIX=
# EMBED_INGEST_CACHE_URL=sqlite://data/cache/embeddings.sqlite3
# EMBED_QUERY_CACHE_URL=              # empty = REDIS_URL; memory:// for an in-process cache
# EMBED_MAX_CONCURRENCY=4             # requests in flight per client
# Chat models (spec P1-01). CHAT_BACKEND=fake switches every profile to FakeChatModel.
# CHAT_BACKEND=gateway
# CHAT_MODEL=deepseek-v4-flash
# CHAT_STRUCTURED_OUTPUT_METHOD=function_calling   # the gateway rejects json_schema (HTTP 400)
# Profiles as JSON; keys left out keep that profile's defaults (shown here).
# Keys: connect_timeout_s, read_timeout_s, deadline_s, max_retries, backoff_s, backoff_max_s,
# max_tokens, temperature, model.
# CHAT_ONLINE='{"connect_timeout_s": 3, "read_timeout_s": 10, "deadline_s": 12, "max_retries": 1}'
# CHAT_CHEAP='{"connect_timeout_s": 3, "read_timeout_s": 8, "deadline_s": 10, "max_tokens": 1024}'
# CHAT_OFFLINE='{"connect_timeout_s": 10, "read_timeout_s": 180, "deadline_s": null, "max_retries": 4}'
# Cost ledger; default <parent of the main checkout>/rag-platform-data/cost/ledger.jsonl,
# shared by every checkout and worktree.
# COST_LEDGER_PATH=C:/workspace/rag-platform-data/cost/ledger.jsonl
# BUDGET_STOP_CNY=28

# Observability (spec P0-11). OTEL_MODE: otlp (to the Collector) | memory (tests) | off.
# OTEL_MODE=otlp
# OTLP_PROTOCOL=grpc                  # or http/protobuf with OTLP_ENDPOINT=http://127.0.0.1:24318
# OTLP_TIMEOUT_S=5
# OTEL_METRIC_EXPORT_INTERVAL_S=30
# OTEL_AUTO_INSTRUMENT=true           # OpenInference spans for LlamaIndex and LangChain/LangGraph
# OTEL_TRACE_CONTENT=true             # prompts, answers and retrieved texts in spans (never vectors)
# GIT_COMMIT=                         # empty: git rev-parse HEAD
# BUSINESS_RECORD_PATH=data/observe/records/business.jsonl   # empty disables
# BUSINESS_RECORD_MAX_BYTES=20000000
# BUSINESS_RECORD_BACKUPS=5
# LOG_DIR=data/observe/logs           # empty: no log file
# LOG_LEVEL=INFO
# LOG_STDERR_LEVEL=WARNING            # OFF: nothing on stderr
# LOG_MAX_BYTES=10000000
# LOG_BACKUPS=3

# ask_docs graph (spec P3-01). One request is one checkpoint thread in CHECKPOINT_URL.
# AGENT_DEADLINE_MS=30000             # total time of one request (at most SEARCH_MAX_DEADLINE_MS)
# AGENT_ANSWER_RESERVE_MS=6000        # time kept for the answer: no further round starts below it
# AGENT_RECURSION_LIMIT=25            # LangGraph steps of one run
# AGENT_TOKEN_CAP=20000               # model tokens of one request
# AGENT_ANSWER_RESERVE_TOKENS=6000    # tokens the calls before the answer must leave free
# AGENT_HISTORY_TURNS=6               # past turns of a session given to the graph; 0 = none
# SESSION_STORE_URL=sqlite://data/sessions/sessions.db   # memory:// for tests
# SESSION_LOCK_URL=memory://          # file://data/locks to also serialise across processes
# Route fallback, rewrite and the question asked back (spec P3-02). The KB's `agent` section
# switches them on (rewrite, clarify, route_model); these settings are the same for every KB.
# AGENT_REWRITE_PROFILE=cheap         # chat profile of the small model (online, offline, cheap)
# AGENT_REWRITE_TIMEOUT_MS=6000       # longest one small-model call; never into the answer's time
# AGENT_REWRITE_HISTORY_TURNS=3       # earlier turns shown to the small model; 0 = none
# AGENT_REWRITE_HISTORY_CHARS=400     # characters of each question or answer shown to it
# AGENT_RESUME_TTL_S=1800             # how long a question asked back waits for its answer
# AGENT_JUDGE_PROFILE=cheap           # chat profile of the sufficiency judge (online, offline, cheap)
# AGENT_JUDGE_TIMEOUT_MS=9000         # longest one judge call; never into the answer's time
# AGENT_JUDGE_CONTEXT_TOKENS=1500     # estimated tokens of fragments shown to the judge
# AGENT_ROUND_MIN_MS=8000             # time one more round needs, on top of the answer's time
# AGENT_ROUND_RATIO=0.9               # ... or this share of the last round's time, if more (P3-06)
# AGENT_SEARCH_MIN_MS=4000            # least time a search of round two or later gets (P3-06)
# SEARCH_RERANK_RESERVE_MS=2000       # query-vector wait ends this long early for the rerank (P3-06)
# SSE_HEARTBEAT_S=10                  # seconds of silence before a streamed answer sends a heartbeat
# SSE_QUEUE_MAX_EVENTS=5000           # events of one stream waiting for the client; past it the run is cancelled
# SERVICE_SHUTDOWN_TIMEOUT_S=5        # seconds the server waits for connections to close at shutdown
# SERVICE_ALLOWED_HOSTS=["docs.example.com"]  # Host names besides localhost and the listen address (JSON list)
