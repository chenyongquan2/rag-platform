# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Model gateway (OpenAI-compatible).
LLM_BASE_URL=
LLM_API_KEY=
EMBED_BASE_URL=
EMBED_API_KEY=

# Optional overrides (defaults in src/rag/config/settings.py).
# ES_URL=http://127.0.0.1:29200
# REDIS_URL=redis://127.0.0.1:26379/0
# DOCSTORE_URL=file://data/docstore
# CHECKPOINT_URL=sqlite://data/checkpoints/langgraph.db
# LOCK_URL=file://data/locks
# OTLP_ENDPOINT=http://127.0.0.1:24317
# HF_ENDPOINT=https://hf-mirror.com
# HF_DATA_DIR=data/raw/hf
# HF_TIMEOUT_S=60

# Embeddings (spec P0-05). EMBED_BACKEND=fake switches ingest and query to FakeEmbedding.
# EMBED_BACKEND=gateway
# EMBED_BATCH_SIZE=10                 # the gateway accepts at most 10 inputs per request
# EMBED_TEXT_PREFIX=
# EMBED_INGEST_CACHE_URL=sqlite://data/cache/embeddings.sqlite3
# EMBED_QUERY_CACHE_URL=              # empty = REDIS_URL; memory:// for an in-process cache
# EMBED_MAX_CONCURRENCY=4             # requests in flight per client
# Chat models (spec P1-01). CHAT_BACKEND=fake switches every profile to FakeChatModel.
# CHAT_BACKEND=gateway
# CHAT_MODEL=deepseek-v4-flash
# CHAT_STRUCTURED_OUTPUT_METHOD=function_calling   # the gateway rejects json_schema (HTTP 400)
# Profiles as JSON; keys left out keep that profile's defaults (shown here).
# Keys: connect_timeout_s, read_timeout_s, deadline_s, max_retries, backoff_s, backoff_max_s,
# max_tokens, temperature, model.
# CHAT_ONLINE='{"connect_timeout_s": 3, "read_timeout_s": 10, "deadline_s": 12, "max_retries": 1}'
# CHAT_CHEAP='{"connect_timeout_s": 3, "read_timeout_s": 8, "deadline_s": 10, "max_tokens": 1024}'
# CHAT_OFFLINE='{"connect_timeout_s": 10, "read_timeout_s": 180, "deadline_s": null, "max_retries": 4}'
# Cost ledger; default <parent of the main checkout>/rag-platform-data/cost/ledger.jsonl,
# shared by every checkout and worktree.
# COST_LEDGER_PATH=C:/workspace/rag-platform-data/cost/ledger.jsonl
# BUDGET_STOP_CNY=28

# Observability (spec P0-11). OTEL_MODE: otlp (to the Collector) | memory (tests) | off.
# OTEL_MODE=otlp
# OTLP_PROTOCOL=grpc                  # or http/protobuf with OTLP_ENDPOINT=http://127.0.0.1:24318
# OTLP_TIMEOUT_S=5
# OTEL_METRIC_EXPORT_INTERVAL_S=30
# OTEL_AUTO_INSTRUMENT=true           # OpenInference spans for LlamaIndex and LangChain/LangGraph
# OTEL_TRACE_CONTENT=true             # prompts, answers and retrieved texts in spans (never vectors)
# GIT_COMMIT=                         # empty: git rev-parse HEAD
# BUSINESS_RECORD_PATH=data/observe/records/business.jsonl   # empty disables
# BUSINESS_RECORD_MAX_BYTES=20000000
# BUSINESS_RECORD_BACKUPS=5
# LOG_DIR=data/observe/logs           # empty: no log file
# LOG_LEVEL=INFO
# LOG_STDERR_LEVEL=WARNING            # OFF: nothing on stderr
# LOG_MAX_BYTES=10000000
# LOG_BACKUPS=3

# ask_docs graph (spec P3-01). One request is one checkpoint thread in CHECKPOINT_URL.
# AGENT_DEADLINE_MS=30000             # total time of one request (at most SEARCH_MAX_DEADLINE_MS)
# AGENT_ANSWER_RESERVE_MS=7000        # time kept for the answer: no further round starts below it
# AGENT_RECURSION_LIMIT=25            # LangGraph steps of one run
# AGENT_TOKEN_CAP=20000               # model tokens of one request
# AGENT_ANSWER_RESERVE_TOKENS=6000    # tokens the calls before the answer must leave free
# AGENT_HISTORY_TURNS=6               # past turns of a session given to the graph; 0 = none
# SESSION_STORE_URL=sqlite://data/sessions/sessions.db   # memory:// for tests
# SESSION_LOCK_URL=memory://          # file://data/locks to also serialise across processes
# Route fallback, rewrite and the question asked back (spec P3-02). The KB's `agent` section
# switches them on (rewrite, clarify, route_model); these settings are the same for every KB.
# AGENT_REWRITE_PROFILE=cheap         # chat profile of the small model (online, offline, cheap)
# AGENT_REWRITE_TIMEOUT_MS=6000       # longest one small-model call; never into the answer's time
# AGENT_REWRITE_HISTORY_TURNS=3       # earlier turns shown to the small model; 0 = none
# AGENT_REWRITE_HISTORY_CHARS=400     # characters of each question or answer shown to it
# AGENT_RESUME_TTL_S=1800             # how long a question asked back waits for its answer
# AGENT_JUDGE_PROFILE=cheap           # chat profile of the sufficiency judge (online, offline, cheap)
# AGENT_JUDGE_TIMEOUT_MS=9000         # longest one judge call; never into the answer's time
# AGENT_JUDGE_CONTEXT_TOKENS=1500     # estimated tokens of fragments shown to the judge
# AGENT_ROUND_MIN_MS=8000             # time one more round needs, on top of the answer's time
# AGENT_ROUND_RATIO=0.9               # ... or this share of the last round's time, if more (P3-06)
# AGENT_SEARCH_MIN_MS=6000            # least time a search of round two or later gets (P3-06)
# AGENT_RERANK_RESERVE_MS=3000        # query-vector wait of a round-two search ends this long early (P3-06)
# AGENT_ANSWER_MAX_TOKENS=1536        # output tokens of the graph's answer call (P3-06)
# SSE_HEARTBEAT_S=10                  # seconds of silence before a streamed answer sends a heartbeat
# SSE_QUEUE_MAX_EVENTS=5000           # events of one stream waiting for the client; past it the run is cancelled
# SERVICE_SHUTDOWN_TIMEOUT_S=5        # seconds the server waits for connections to close at shutdown
# SERVICE_ALLOWED_HOSTS=["docs.example.com"]  # Host names besides localhost and the listen address (JSON list)

# Result cache (spec P5-01, design s12). CACHE_MODE: off | l1 (exact cache for search_docs and
# ask_docs in Redis) | l1_shadow (l1 plus the semantic cache that only records what it would do).
# CACHE_MODE=l1_shadow
# CACHE_URL=                          # empty = REDIS_URL
# CACHE_KEY_PREFIX=rag:l1:
# CACHE_TIMEOUT_MS=50                 # connect and each command; slower counts as down (bypass)
# CACHE_TTL_S=3600                    # CACHE_NOT_FOUND_TTL_S=600 for a not-found result
# CACHE_MAX_VALUE_BYTES=262144
# CACHE_BREAKER_FAILURES=5            # failures in a row before nothing is sent for ...
# CACHE_BREAKER_OPEN_S=5.0
# CACHE_LOCK_TTL_MS=30000             # CACHE_LOCK_WAIT_MS=3000  CACHE_LOCK_POLL_MS=25
# CACHE_ASK_ANSWERS=true              # also cache the final answers of ask_docs (design: no L3)
# CACHE_SEMANTIC_STORE=memory         # memory | es: `es` creates the index cache_semantic_<kb> in
#                                     # the real Elasticsearch (one 1024-number vector per clean
#                                     # miss; expired ones are deleted every 500 writes)
# CACHE_SEMANTIC_THRESHOLD=0.20       # how far the shadow records look; `shadow-report
#                                     # --max-distance 0.06` reads them as the dev-chosen 0.06
# CACHE_SEMANTIC_LEXICAL_GUARD=true
# CACHE_SHADOW_DIR=data/observe/cache # shadow.jsonl; `python -m rag.cache shadow-report`

# Monitoring (spec P5-02; README "Monitoring"). Every value below is optional.
# Docker Compose reads these from .env too:
# GRAFANA_ADMIN_PASSWORD=             # Grafana admin login (default admin); viewing needs none
# COLLECTOR_EXTRA=none                # Collector overlay in deploy/otel/: none | langfuse
# The alert receiver (`python -m rag.monitor receiver`):
# ALERT_WEBHOOK_URL=                  # a secret: chat webhook that gets every firing/resolved line
# ALERT_RECEIVER_HOST=127.0.0.1
# ALERT_RECEIVER_PORT=29093
# ALERT_LOG_PATH=data/observe/alerts.jsonl
# App-side reachability gauge of Elasticsearch and Redis:
# DEPENDENCY_CHECK_TIMEOUT_S=1.5
# DEPENDENCY_CHECK_TTL_S=10
# The probe (`python -m rag.monitor probe`); its requests have X-Request-Id probe-<hex>:
# PROBE_URL=                          # empty: http://SERVICE_HOST:SERVICE_PORT
# PROBE_KB=hf_docs
# PROBE_QUERY=How do I upload a model to the Hugging Face Hub with push_to_hub?
# PROBE_EXPECTED=chapter4/3.mdx       # part of the source path, URL or title of a passage that must come back
# PROBE_TOP_K=5
# PROBE_UNIQUE_QUERY=true             # a made-up word per run, so the result cache cannot answer
# PROBE_INTERVAL_S=60
# PROBE_TIMEOUT_S=20
# PROBE_METRIC_EXPORT_INTERVAL_S=10
# PROBE_ASK_ENABLED=false             # the ask_docs check costs model calls
# PROBE_ASK_QUESTION=How do I upload a model to the Hugging Face Hub with push_to_hub?
# PROBE_ASK_INTERVAL_S=1800
# PROBE_ASK_TIMEOUT_S=45
# PROBE_ASK_DAILY_CAP=3
# PROBE_STATE_PATH=data/observe/probe_state.json
# Online sampling (`python -m rag.eval.online_sample`), one cheap judge call per request:
# ONLINE_EVAL_N=20                    # never more than 50
# ONLINE_EVAL_K=5                     # passages judged per request (hit@k, MRR)
# ONLINE_EVAL_WINDOW_HOURS=168
# ONLINE_EVAL_MAX_CNY=0.20            # the job stops itself after this much
# ONLINE_EVAL_EST_CNY_PER_CALL=0.007  # estimate checked against the ledger before the first call
# ONLINE_EVAL_REPORT_DIR=data/reports/online
# Trace files of the Collector (`python -m rag.monitor prune`):
# TRACE_RETENTION_DIR=data/otel
# TRACE_RETENTION_PATTERN=traces*
# TRACE_RETENTION_DAYS=3
# TRACE_RETENTION_MAX_MB=100
# Langfuse profile: `uv run python -m rag.monitor langfuse-env` writes random values for all of
# these into .env (never commit them); listed here only so the names are known.
# LANGFUSE_DB_PASSWORD=
# LANGFUSE_REDIS_PASSWORD=
# LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_MINIO_PASSWORD=
# LANGFUSE_SALT=
# LANGFUSE_ENCRYPTION_KEY=
# LANGFUSE_NEXTAUTH_SECRET=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_INIT_USER_EMAIL=admin@localhost.test
# LANGFUSE_INIT_USER_PASSWORD=
# LANGFUSE_BASIC_AUTH=                # base64 of "<public key>:<secret key>", read by the Collector overlay
